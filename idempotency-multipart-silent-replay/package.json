    "@nestjs/platform-express": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "multer": "2.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/multer": "2.3.0",
    "@types/node": "22.10.2",
    "tsx": "4.23.15",
    "typescript": "5.7.2"
  }
