{
  "name": "outbox-payload-unstorable-text",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "@nestjs/outbox Postgres store: outbox.add() throws a raw driver error for a payload or header string with U+0000 or a lone surrogate",
  "scripts": {
    "repro": "tsx src/repro.ts",
    "repro:pg": "DATABASE_URL=${DATABASE_URL:-postgres://postgres:postgres@127.0.0.1:55434/postgres} tsx src/repro.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/outbox": "0.1.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.7.2"
  }
}
